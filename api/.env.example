DATABASE_URL=postgresql+psycopg://transcributed:transcributed@localhost:5432/transcributed
RABBITMQ_URL=amqp://transcributed:transcributed@localhost:5672/
RABBITMQ_ENABLED=true
RABBITMQ_CONNECT_TIMEOUT_SECONDS=5

NAS_INPUT_ROOT=./samples

WORKER_BACKEND=faster-whisper
# WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_LOCAL_FILES_ONLY=false
FFMPEG_BINARY=ffmpeg
# WHISPER_MODEL_DIR=./models

LOG_LEVEL=INFO
